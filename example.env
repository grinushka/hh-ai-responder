# Ссылка на поиск вакансий
HH_SEARCH_URL=https://hh.ru/search/vacancy?text=python

# ID резюме (если не указан — используется последнее)
HH_RESUME=

# OpenAI-compatible API
HH_AI_BASE_URL=http://localhost:11434
HH_AI_MODEL=llama3.1:8b
HH_AI_API_KEY=

# Максимум успешных откликов за один проход (0 — без лимита)
HH_MAX_APPLICATIONS_PER_RUN=15

# Пауза между проходами откликов. Можно 2h или просто 2 (часы)
HH_APPLY_INTERVAL=2h

# Генерировать сопроводительное письмо для каждого отклика
HH_FORCE_LETTER=true

# Способ генерации сопроводительного письма: ai или template
HH_LETTER_MODE=template
HH_LETTER_TEMPLATE_PATH=cover-letter-template.txt

# Автоответы в чатах с работодателями (false — выключено)
HH_ENABLE_AUTO_ANSWER=false
